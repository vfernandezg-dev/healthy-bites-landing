# URL pública del web-app (Angular). La landing enlaza aquí para iniciar sesión y registrarse.
PUBLIC_APP_URL=https://healthy-bites-v1.netlify.app

# URL base de la API REST (healthy-bites-api). Se usa para el formulario de contacto.
# En local: http://localhost:8090/api/v1
PUBLIC_API_URL=https://healthybites-api-latest.onrender.com/api/v1

