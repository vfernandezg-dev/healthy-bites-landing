---
import { Plus } from 'lucide-react';

import SectionHeading from '@/components/ui/SectionHeading.astro';
import { faqs } from '@/data/site';
import { sectionHref } from '@/lib/config';
---

<section id="faq" aria-labelledby="faq-title" class="bg-white py-20 sm:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-6 lg:grid-cols-[1fr_1.5fr] lg:gap-16 lg:px-8">
    <SectionHeading
      id="faq-title"
      align="left"
      eyebrow="Preguntas frecuentes"
      title="Resolvemos tus dudas"
      description="Lo esencial para empezar con Healthy Bites."
    >
      <p class="mt-6 text-muted">
        ¿No encuentras tu respuesta?{' '}
        <a
          href={sectionHref('contacto')}
          class="font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-800"
        >
          Escríbenos
        </a>
        .
      </p>
    </SectionHeading>

    <div
      data-reveal
      class="divide-y divide-brand-900/10 overflow-hidden rounded-3xl bg-surface ring-1 ring-brand-900/5"
    >
      {faqs.map((faq) => (
        <details data-accordion-item class="faq-item group px-6 sm:px-8">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-xl py-5 font-semibold text-ink transition-colors hover:text-brand-800 [&::-webkit-details-marker]:hidden">
            {faq.question}
            <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full bg-mint text-brand-800">
              <Plus aria-hidden="true" className="size-4" />
            </span>
          </summary>
          <div data-accordion-content class="pr-12 pb-6">
            <p class="leading-relaxed text-muted">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { initAccordions } from '@/scripts/accordion';

  initAccordions();
</script>
