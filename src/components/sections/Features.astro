---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { features } from '@/data/site';
---

<section
  id="funciones"
  aria-labelledby="funciones-title"
  class="border-y border-brand-900/5 bg-white py-20 sm:py-28"
>
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <SectionHeading
      id="funciones-title"
      eyebrow="Funciones"
      title="Todo lo que necesitas para cuidar tu alimentación"
      description="Una sola plataforma para aprender, planificar y mantener la constancia, con herramientas pensadas para el día a día."
    />

    <ul role="list" class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature, index) => (
        <li
          data-reveal
          style={`--reveal-delay: ${(index % 3) * 90}ms`}
          class="group flex gap-5 rounded-3xl bg-surface p-6 ring-1 ring-brand-900/5 transition duration-300 hover:-translate-y-1 hover:bg-white hover:shadow-card-hover sm:block sm:p-8"
        >
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-mint text-brand-800 transition-colors duration-300 group-hover:bg-brand-700 group-hover:text-white">
            <feature.icon aria-hidden="true" className="size-6" />
          </span>
          <div>
            <h3 class="text-lg font-bold text-ink sm:mt-6">{feature.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{feature.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
