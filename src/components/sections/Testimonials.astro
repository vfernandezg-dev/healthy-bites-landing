---
import { Quote } from 'lucide-react';

import SectionHeading from '@/components/ui/SectionHeading.astro';
import { testimonials } from '@/data/site';

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section
  id="testimonios"
  aria-labelledby="testimonios-title"
  class="relative isolate overflow-hidden bg-brand-950 py-20 sm:py-28"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/2 size-[40rem] -translate-x-1/2 rounded-full bg-brand-700/25 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <SectionHeading
      id="testimonios-title"
      tone="dark"
      eyebrow="Testimonios"
      title="Historias de quienes ya comen mejor"
    >
      <p class="mt-4 text-sm text-brand-200">
        Testimonios ilustrativos: Healthy Bites es un proyecto académico.
      </p>
    </SectionHeading>

    <ul role="list" class="mt-14 grid gap-6 md:grid-cols-3">
      {testimonials.map((testimonial, index) => (
        <li data-reveal style={`--reveal-delay: ${index * 110}ms`}>
          <figure class="flex h-full flex-col rounded-3xl bg-white/[0.06] p-8 ring-1 ring-white/10">
            <Quote aria-hidden="true" className="size-8 text-brand-400" />
            <blockquote class="mt-5 flex-1 leading-relaxed text-brand-50">
              <p>{testimonial.quote}</p>
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-4">
              <span
                aria-hidden="true"
                class="grid size-12 place-items-center rounded-full bg-mint font-bold text-brand-900"
              >
                {initials(testimonial.name)}
              </span>
              <span>
                <span class="block font-bold text-white">{testimonial.name}</span>
                <span class="block text-sm text-brand-300">{testimonial.role}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
