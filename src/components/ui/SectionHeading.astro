---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  tone?: 'light' | 'dark';
}

const { id, eyebrow, title, description, align = 'center', tone = 'light' } = Astro.props;
const isDark = tone === 'dark';
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  <p
    class:list={[
      'text-sm font-bold tracking-wider uppercase',
      isDark ? 'text-brand-300' : 'text-brand-700',
    ]}
  >
    {eyebrow}
  </p>
  <h2
    id={id}
    class:list={[
      'mt-3 text-3xl font-extrabold tracking-tight text-balance sm:text-4xl',
      isDark ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {description && (
    <p class:list={['mt-4 text-lg text-pretty', isDark ? 'text-brand-100' : 'text-muted']}>
      {description}
    </p>
  )}
  <slot />
</div>
