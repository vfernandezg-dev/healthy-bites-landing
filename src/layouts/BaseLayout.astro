---
import '@/styles/global.css';

import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import { site } from '@/data/site';
import { basePath } from '@/lib/config';

interface Props {
  title?: string;
  description?: string;
  /** Páginas que no deben indexarse (p. ej. 404). */
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

const siteRoot = new URL(basePath, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('og-image.jpg', siteRoot);
const asset = (file: string) => `${basePath}${file}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: site.name,
      url: siteRoot.href,
      logo: new URL('icon-512.png', siteRoot).href,
      email: site.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Trujillo', addressCountry: 'PE' },
    },
    {
      '@type': 'WebSite',
      name: site.name,
      url: siteRoot.href,
      inLanguage: 'es',
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    <meta name="theme-color" content="#237047" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href={asset('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Healthy Bites: nutrición, hábitos y comunidad en un solo lugar"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only rounded-full bg-brand-700 px-5 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60]"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <Footer />

    <script>
      import { initCleanAnchors } from '@/scripts/anchors';
      import { initReveal } from '@/scripts/reveal';

      initReveal();
      initCleanAnchors();
    </script>
  </body>
</html>
